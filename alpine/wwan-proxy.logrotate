/var/log/wwan-proxy/service.log {
    daily
    maxsize 10M
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su root root
}

/var/log/wwan-proxy-install.log {
    monthly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su root root
}
