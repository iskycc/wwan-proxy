{
  "name": "wwan-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "screenshots": "WWAN_UI_SCREENSHOTS=1 playwright test screenshots.spec.ts",
    "format": "prettier --write src tests *.config.ts *.json index.html README.md"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@ant-design/plots": "2.6.8",
    "antd": "6.6.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "8.3.3"
  }
}
