#!/bin/sh /etc/rc.common

START=98
STOP=11
USE_PROCD=1

PROG="/opt/wwan-proxy/wwan-proxy"
INSTALLER="/opt/wwan-proxy/install-openwrt.sh"
RUNTIME_DIR="/var/run/wwan-proxy"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$INSTALLER" ] || return 1
	mkdir -p "$RUNTIME_DIR" || return 1
	chmod 0750 "$RUNTIME_DIR" || return 1

	procd_open_instance updater
	procd_set_param command "$PROG" \
		-update-agent \
		-update-platform openwrt \
		-update-group root \
		-update-socket "$RUNTIME_DIR/update.sock" \
		-update-status "$RUNTIME_DIR/update-status.json" \
		-update-installer "$INSTALLER" \
		-update-binary "$PROG"
	# A successful update intentionally exits this agent so procd loads the new
	# binary. retry=0 keeps that restart behavior available for every update.
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
